# Default environment for the pathfinder HTTP server daemon.
#
# Override these values by editing this file or by dropping a systemd
# override with `systemctl edit pathfinder-http.service`.

# Directory must exist and be writable by the user running the service.
PATHFINDER_HTTP_DB_PATH=/var/lib/pathfinder-http/pathfinder.db

# Interface and port to bind. Use 127.0.0.1:8765 to listen on localhost only,
# or 0.0.0.0:8765 to listen on all interfaces.
PATHFINDER_HTTP_LISTEN_ADDR=0.0.0.0:8765
